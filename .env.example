# SafarBuddy V2 — Environment Variable Reference
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env`, `.env.local`, or any `.env.*.local` file.
#
# Variable names below are sourced directly from the validated schema in
# src/lib/config/env.ts. Do not add variables that are not validated there.

# --- Node ---
NODE_ENV=development

# --- Database (Drizzle / Postgres, used by src/db) ---
DATABASE_URL=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cashfree (payments) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=noreply@safarbuddy.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=safarbuddytravel@gmail.com

# --- CAPTCHA (Cloudflare Turnstile) ---
# Free at dash.cloudflare.com > Turnstile.
# Leave both empty to keep CAPTCHA off.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
