# SafarBuddy V2 — Environment Variable Reference
#
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env`, `.env.local`, or any `.env.*.local` file.
#
# Variable names below are sourced directly from the validated schema in
# src/lib/config/env.ts. Do not add variables that are not validated there.

# --- Node ---
NODE_ENV=development

# --- Database (Drizzle / Postgres, used by src/db) ---
DATABASE_URL=
# Optional (GOLIVE-11): Supabase CA certificate (PEM). When set, the DB TLS
# certificate is verified. Leave empty to keep the previous behaviour.
DATABASE_SSL_CA=

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Cashfree (payments) ---
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2023-08-01
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# --- Payment reconciliation cron (GOLIVE-03) ---
# Any long random string (16+ chars), e.g. `openssl rand -hex 32`.
# Vercel Cron sends it automatically as `Authorization: Bearer <value>`.
# Leave empty to keep /api/public/cron/reconcile-payments switched off.
CRON_SECRET=

# --- Email ---
RESEND_API_KEY=
EMAIL_FROM=noreply@safarbuddy.com
GMAIL_USER=
GMAIL_APP_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=safarbuddytravel@gmail.com

# --- CAPTCHA (Cloudflare Turnstile) ---
# Free at dash.cloudflare.com > Turnstile.
# Leave both empty to keep CAPTCHA off.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- AI assistant (Google Gemini, free key from aistudio.google.com) ---
# Leave GEMINI_API_KEY empty to keep the homepage chat in "not set up yet" mode.
# GEMINI_MODEL is optional (default gemini-2.5-flash).
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional (GOLIVE-15): your Google Business Profile "write a review" link.
# Shown on the thank-you screen after a guest reviews a stay. Leave empty to hide it.
NEXT_PUBLIC_GOOGLE_REVIEW_URL=
